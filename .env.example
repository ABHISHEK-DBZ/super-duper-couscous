# Gemma 4 AI Provider Configuration
# Set these variables to enable AI-powered migration planning with Gemma 4.
# If unset or disabled, the deterministic scanner and independent verification engine remain 100% functional.
# Option 1: Google Gemini API (Google Generative AI) - Free Tier Gemma 4 Model
GEMMA_API_KEY=your_gemini_api_key_here
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 2: Together AI / OpenAI-compatible endpoint
# GEMMA_API_KEY=your_together_api_key_here
# GEMMA_API_BASE_URL=https://api.together.xyz/v1
# GEMMA_MODEL=google/gemma-4-27b-it

# Option 3: Local Ollama adapter
# GEMMA_API_KEY=""
# GEMMA_API_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma4:latest

# GitHub OAuth Integration Settings
# Optional: Set these to enable server-side GitHub repository discovery and cloning
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
# Leave empty locally: the callback is derived from APP_BASE_URL or the request origin.
GITHUB_REDIRECT_URI=
GITHUB_OAUTH_STATE_TTL_SECONDS=600

# Application & Session Settings
# Public origin in production (e.g. https://exit-capsule.example.com). Empty = derive from request.
APP_BASE_URL=
# Frontend origin for the OAuth redirect safety net in dev. Empty = same origin.
FRONTEND_URL=
# Encryption key for stored GitHub tokens. Generate once:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset, a per-install key is generated into backend/.secret_key.
SECRET_KEY=
SESSION_COOKIE_NAME=ec_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
# Public deployments: reject API calls that have no GitHub session (set true).
REQUIRE_AUTH=false
# Comma-separated directories local scans may read. Empty = local mode, any directory.
ALLOWED_SCAN_ROOTS=
# Comma-separated allowed browser origins in production, e.g. https://your-domain.com
CORS_ORIGINS=

# Security & Sandboxing Settings
COMMAND_TIMEOUT_SECONDS=120
MAX_COMMAND_OUTPUT_BYTES=524288
MAX_SOURCE_SNIPPET_LINES=80
ENABLE_REMOTE_INFERENCE=false

# Storage Settings
DATABASE_PATH=exit_capsule.db
CAPSULES_DIR=generated_capsules
TEMP_WORKSPACES_DIR=temp_workspaces

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
